# Only the local authority can allocate. Browsers use the public relay candidates.
listening-ip=127.0.0.1
listening-port=3478
relay-ip={{ wake_lan_ip }}
external-ip={{ wake_public.content | trim }}/{{ wake_lan_ip }}
min-port=49160
max-port=49200
realm={{ wake_domain }}
lt-cred-mech
user=wake:{{ wake_password.content | b64decode | trim }}
user-quota=8
total-quota=8
no-cli
no-tls
no-dtls
no-tcp-relay
no-multicast-peers
no-rfc5780
no-stun
relay-threads=1
pidfile=/run/wake-velocity-relay/turnserver.pid
log-file=stdout
simple-log
