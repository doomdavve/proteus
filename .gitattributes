# Plugin packages keep LF on every checkout, so their bytes, digests and diagnostic lines are the
# same on Windows (validate_boat_plugin_session edits main.lua across lines).
plugins/** text eol=lf
# Compiled synthetic geometry and its review records use the same text bytes on all hosts.
assets/geometry/archipelago/*.h text eol=lf
assets/geometry/archipelago/*.json text eol=lf
assets/geometry/archipelago/*.svg text eol=lf
