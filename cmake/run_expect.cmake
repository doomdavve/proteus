# Run a command and require both a zero exit code and, when REGEX is set, a match in its
# output (CTest ignores the exit code once PASS_REGULAR_EXPRESSION is set).
#   cmake -DREGEX=<regex> -P run_expect.cmake -- <program> <args...>
set(command)
set(collect FALSE)
math(EXPR last "${CMAKE_ARGC} - 1")
foreach(i RANGE 0 ${last})
  if(collect)
    list(APPEND command "${CMAKE_ARGV${i}}")
  elseif("${CMAKE_ARGV${i}}" STREQUAL "--")
    set(collect TRUE)
  endif()
endforeach()
if(NOT command)
  message(FATAL_ERROR "run_expect: no command after --")
endif()
execute_process(COMMAND ${command} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("${out}${err}")
if(NOT code EQUAL 0)
  message(FATAL_ERROR "run_expect: exit code ${code}")
endif()
if(REGEX AND NOT "${out}${err}" MATCHES "${REGEX}")
  message(FATAL_ERROR "run_expect: output does not match ${REGEX}")
endif()
